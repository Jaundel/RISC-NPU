-- ============================================================
-- system_memory.mif  — RISC-NPU Benchmark Program
-- ============================================================
-- BENCHMARK: Compute 50 × 50 = 2500 two ways:
--   Section A (addr 0–52):  SOFTWARE — repeated addition (50 ADDs)
--   Section B (addr 53–56): HARDWARE — single MAC instruction
--
-- EXPECTED RESULTS (both stored in data_mem):
--   data_mem[0] = 0x000009C4 (2500) — software result
--   data_mem[1] = 0x000009C4 (2500) — hardware result
--
-- CYCLE COUNT ANALYSIS:
--   Each instruction (LDIA/LDIB/ADD/STA) = 3 cycles
--   MAC instruction = 15 cycles (1 fetch + 1 decode + 13 MAC_WAIT)
--
--   Software section: (1 + 1 + 50 + 1) × 3       = 159 cycles
--   Hardware section: (1 + 1) × 3 + 15 + 3        =  24 cycles
--   Full speedup:     159 / 24                    =  6.6×
--   Multiply-only:    (50 ADDs × 3) / (13 stalls)  = 10.0×
--
-- INSTRUCTION ENCODING:
--   LDIA imm  : 0x0_______  opcode=0000, bits[27:0]=immediate
--   LDIB imm  : 0x1_______  opcode=0001, bits[27:0]=immediate
--   ADD       : 0x70000000  opcode(8-bit)=01110000
--   STA addr  : 0x200000xx  opcode=0010, bits[7:0]=data_mem_address
--   MAC       : 0xB0000000  opcode=1011
-- ============================================================

WIDTH=32;
DEPTH=64;

ADDRESS_RADIX=UNS;
DATA_RADIX=HEX;

CONTENT BEGIN

-- ----------------------------------------------------------
-- SECTION A: SOFTWARE multiply  50 x 50  (repeated addition)
-- Cycle budget: 159 cycles
-- A = 0 initially; B = 50 (addend, fixed throughout loop)
-- Each ADD: A = A + B  →  after 50 ADDs: A = 2500
-- ----------------------------------------------------------
0  : 00000000;  -- LDIA 0         A = 0  (running sum)
1  : 10000032;  -- LDIB 50        B = 50 (addend, preserved by ADD)

-- 50 repeated additions (addresses 2–51)
2  : 70000000;  -- ADD            A = 50
3  : 70000000;  -- ADD            A = 100
4  : 70000000;  -- ADD            A = 150
5  : 70000000;  -- ADD            A = 200
6  : 70000000;  -- ADD            A = 250
7  : 70000000;  -- ADD            A = 300
8  : 70000000;  -- ADD            A = 350
9  : 70000000;  -- ADD            A = 400
10 : 70000000;  -- ADD            A = 450
11 : 70000000;  -- ADD            A = 500
12 : 70000000;  -- ADD            A = 550
13 : 70000000;  -- ADD            A = 600
14 : 70000000;  -- ADD            A = 650
15 : 70000000;  -- ADD            A = 700
16 : 70000000;  -- ADD            A = 750
17 : 70000000;  -- ADD            A = 800
18 : 70000000;  -- ADD            A = 850
19 : 70000000;  -- ADD            A = 900
20 : 70000000;  -- ADD            A = 950
21 : 70000000;  -- ADD            A = 1000
22 : 70000000;  -- ADD            A = 1050
23 : 70000000;  -- ADD            A = 1100
24 : 70000000;  -- ADD            A = 1150
25 : 70000000;  -- ADD            A = 1200
26 : 70000000;  -- ADD            A = 1250
27 : 70000000;  -- ADD            A = 1300
28 : 70000000;  -- ADD            A = 1350
29 : 70000000;  -- ADD            A = 1400
30 : 70000000;  -- ADD            A = 1450
31 : 70000000;  -- ADD            A = 1500
32 : 70000000;  -- ADD            A = 1550
33 : 70000000;  -- ADD            A = 1600
34 : 70000000;  -- ADD            A = 1650
35 : 70000000;  -- ADD            A = 1700
36 : 70000000;  -- ADD            A = 1750
37 : 70000000;  -- ADD            A = 1800
38 : 70000000;  -- ADD            A = 1850
39 : 70000000;  -- ADD            A = 1900
40 : 70000000;  -- ADD            A = 1950
41 : 70000000;  -- ADD            A = 2000
42 : 70000000;  -- ADD            A = 2050
43 : 70000000;  -- ADD            A = 2100
44 : 70000000;  -- ADD            A = 2150
45 : 70000000;  -- ADD            A = 2200
46 : 70000000;  -- ADD            A = 2250
47 : 70000000;  -- ADD            A = 2300
48 : 70000000;  -- ADD            A = 2350
49 : 70000000;  -- ADD            A = 2400
50 : 70000000;  -- ADD            A = 2450
51 : 70000000;  -- ADD            A = 2500  ← 50th addition, result complete

52 : 20000000;  -- STA 0x00       data_mem[0] = 2500 (0x000009C4)

-- ----------------------------------------------------------
-- SECTION B: HARDWARE multiply  50 x 50  (single MAC)
-- Cycle budget: 24 cycles
-- LDIA/LDIB load operands into reg A/B lower 8 bits
-- MAC dispatches to NPU: stalls CPU for ~13 cycles
-- NPU: mul(50,50)=2500, acc=0+2500=2500, relu(2500)=2500
-- Result sign-extended to 32 bits → 0x000009C4
-- ----------------------------------------------------------
53 : 00000032;  -- LDIA 50        A = 50  (op_a for NPU)
54 : 10000032;  -- LDIB 50        B = 50  (op_b for NPU)
55 : B0000000;  -- MAC            A = NPU(50 x 50) = 2500, CPU stalls ~13 cycles
56 : 20000001;  -- STA 0x01       data_mem[1] = 2500 (0x000009C4)

-- ----------------------------------------------------------
-- HALT: fetch LDIA 0 forever (harmless infinite spin)
-- PC continues incrementing through NOP instructions
-- ----------------------------------------------------------
[57..63] : 00000000;  -- LDIA 0 (NOP spin)

END;
