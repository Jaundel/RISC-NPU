set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY neural_image_system
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name SDC_FILE Neural-Image.sdc
set_global_assignment -name VHDL_FILE ../../multiplier.vhd
set_global_assignment -name VHDL_FILE ../../accumulator.vhd
set_global_assignment -name VHDL_FILE ../../relu.vhd
set_global_assignment -name VHDL_FILE ../../npu_core.vhd
set_global_assignment -name VHDL_FILE ../../fulladd.vhd
set_global_assignment -name VHDL_FILE ../../adder4.vhd
set_global_assignment -name VHDL_FILE ../../adder16.vhd
set_global_assignment -name VHDL_FILE ../../adder32.vhd
set_global_assignment -name VHDL_FILE ../../add.vhd
set_global_assignment -name VHDL_FILE ../../mux2to1.vhd
set_global_assignment -name VHDL_FILE ../../mux4to1.vhd
set_global_assignment -name VHDL_FILE ../../register32.vhd
set_global_assignment -name VHDL_FILE ../../PC.vhd
set_global_assignment -name VHDL_FILE ../../LZE.vhd
set_global_assignment -name VHDL_FILE ../../UZE.vhd
set_global_assignment -name VHDL_FILE ../../RED.vhd
set_global_assignment -name VHDL_FILE ../../alu.vhd
set_global_assignment -name VHDL_FILE ../../data_mem.vhd
set_global_assignment -name VHDL_FILE ../../data_path.vhd
set_global_assignment -name VHDL_FILE ../../reset_circuit.vhd
set_global_assignment -name VHDL_FILE ../../Control_New.vhd
set_global_assignment -name VHDL_FILE ../../cpu1.vhd
set_global_assignment -name VHDL_FILE ../../neural/generated/neural_program.vhd
set_global_assignment -name VHDL_FILE ../../neural/neural_image_system.vhd
# Core-only synthesis. Virtual outputs preserve interfaces for area/timing
# characterization; this is NOT a board pinout or deployable display design.
set_location_assignment PIN_Y2 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to pixel_valid
set_instance_assignment -name VIRTUAL_PIN ON -to frame_done
set_instance_assignment -name VIRTUAL_PIN ON -to pixel_index[*]
set_instance_assignment -name VIRTUAL_PIN ON -to pixel_rgb[*]
set_instance_assignment -name VIRTUAL_PIN ON -to cycle_count[*]
set_instance_assignment -name VIRTUAL_PIN ON -to debug_pc[*]
set_instance_assignment -name VIRTUAL_PIN ON -to debug_a[*]
set_instance_assignment -name VIRTUAL_PIN ON -to debug_b[*]
set_instance_assignment -name VIRTUAL_PIN ON -to debug_phase[*]

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"